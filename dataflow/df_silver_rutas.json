{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "rutas"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> rutas",
				"rutas derive(RutaHistoricaId = concat('RH-', lpad(regexExtract(trim(RutaHistoricaId), '(\\\\d+)', 1), 2, '0'),\r",
				"  iif(regexMatch(upper(trim(RutaHistoricaId)), '.*-(N|S|NEW)$'),\r",
				"      concat('-', regexExtract(upper(trim(RutaHistoricaId)), '-(N|S|NEW)$', 1)),\r",
				"      '')),",
				"          CodigoRuta = coalesce(trim(CodigoRuta), 'SIN_CODIGO'),",
				"          NombreRuta = regexReplace(trim(NombreRuta), '^(RH-|R-?|Ruta\\\\s*)\\\\d{1,2}(-(N|S|NEW))?\\\\s+', ''),",
				"          Origen = coalesce(trim(Origen), 'SIN_ORIGEN'),",
				"          Destino = coalesce(trim(Destino), 'SIN_DESTINO'),",
				"          Estado = coalesce(upper(trim(Estado)), 'DESCONOCIDO')) ~> derivedColumn1",
				"aggregate1 derive(VigenciaDesde = coalesce(\r",
				"    iif(regexMatch(VigenciaDesde, '^[0-9]{5}$'), \r",
				"        toDate(toString(toTimestamp(VigenciaDesde, 'yyyy-MM-dd')), 'yyyy-MM-dd'), \r",
				"        iif(instr(VigenciaDesde, '/') > 0, \r",
				"            toDate(VigenciaDesde, 'dd/MM/yyyy'), \r",
				"            toDate(VigenciaDesde, 'yyyy-MM-dd')\r",
				"        )\r",
				"    ), \r",
				"    toDate('1900-01-01', 'yyyy-MM-dd')\r",
				"),",
				"          VigenciaHasta = coalesce(\r",
				"    iif(regexMatch(VigenciaHasta, '^[0-9]{5}$'), \r",
				"        toDate(toString(toTimestamp(VigenciaHasta, 'yyyy-MM-dd')), 'yyyy-MM-dd'), \r",
				"        iif(instr(VigenciaHasta, '/') > 0, \r",
				"            toDate(VigenciaHasta, 'dd/MM/yyyy'), \r",
				"            toDate(VigenciaHasta, 'yyyy-MM-dd')\r",
				"        )\r",
				"    ), \r",
				"    toDate('1900-01-01', 'yyyy-MM-dd')\r",
				")) ~> derivedColumn2",
				"derivedColumn1 aggregate(groupBy(RutaHistoricaId),",
				"     CodigoRuta = first(CodigoRuta),",
				"          NombreRuta = first(NombreRuta),",
				"          Origen = first(Origen),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Destino = first(Destino),",
				"          Estado = first(Estado)) ~> aggregate1",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}