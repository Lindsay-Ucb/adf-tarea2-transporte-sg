{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "demandaParadas"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT * FROM bronze.DemandaParadas',",
				"     format: 'query') ~> demandaParadas",
				"demandaParadas derive(FechaServicio = case(\r",
				"  regexMatch(toString(FechaServicio), '^\\\\d{4}-\\\\d{2}-\\\\d{2}$'),\r",
				"    toDate(toString(FechaServicio), 'yyyy-MM-dd'),\r",
				"  regexMatch(toString(FechaServicio), '^\\\\d{2}/\\\\d{2}/\\\\d{4}$'),\r",
				"    toDate(toString(FechaServicio), 'dd/MM/yyyy'),\r",
				"  regexMatch(toString(FechaServicio), '^\\\\d{5}$'),\r",
				"    addDays(toDate('1899-12-30'), toInteger(toString(FechaServicio))),\r",
				"  toDate(null())),",
				"          RutaHistoricaId = iif(regexMatch(trim(RutaHistoricaId), '^RH-\\\\d{2}$'),\r",
				"    trim(RutaHistoricaId),\r",
				"    concat('RH-', lpad(regexExtract(RutaHistoricaId, '(\\\\d+)', 1), 2, '0')))) ~> derivedColumn1",
				"derivedColumn1 derive(DemandaId = iif(!isNull(DemandaId) && trim(DemandaId) != '',\r",
				"    trim(DemandaId),\r",
				"    concat('DM-', toString(FechaServicio, 'yyyyMMdd'), '-',\r",
				"           regexExtract(RutaHistoricaId, '(\\\\d+)', 1), '-',\r",
				"           ParadaHistoricaId, '-',\r",
				"           left(Franja, 2)))) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}