{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "demandaParadas"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> demandaParadas",
				"demandaParadas derive(DemandaId = trim(DemandaId),",
				"          RutaHistoricaId = trim(RutaHistoricaId),",
				"          ParadaHistoricaId = trim(ParadaHistoricaId),",
				"          Franja = trim(Franja),",
				"          ValidacionesTarjeta = toInteger(coalesce(trim(ValidacionesTarjeta), '0')),",
				"          Descensos = toInteger(coalesce(trim(Descensos), '0')),",
				"          DemandaNoAtendida = toInteger(coalesce(trim(DemandaNoAtendida), '0')),",
				"          Metodo = upper(trim(Metodo))) ~> derivedColumn1",
				"derivedColumn1 derive(FechaServicio = coalesce(toDate(FechaServicio, 'yyyy-MM-dd'), toDate('1900-01-01', 'yyyy-MM-dd'))) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}