{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "Paradas"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Paradas",
				"Paradas derive(ParadaHistoricaId = trim(ParadaHistoricaId),",
				"          NombreParada = trim(NombreParada),",
				"          Zona = upper(trim(Zona)),",
				"          Estado = upper(trim(Estado)),",
				"          CodigoPublicado = coalesce(trim(CodigoPublicado), trim(ParadaHistoricaId))) ~> derivedColumn1",
				"aggregate1 derive(Latitud = toDecimal(coalesce(trim(Latitud), '0.0')),",
				"          Longitud = toDecimal(coalesce(trim(Longitud), '0.0'))) ~> derivedColumn2",
				"derivedColumn2 derive(VigenciaDesde = coalesce(\r",
				"    iif(\r",
				"        instr(VigenciaDesde, '/') > 0, \r",
				"        toDate(VigenciaDesde, 'dd/MM/yyyy'), \r",
				"        toDate(VigenciaDesde, 'yyyy-MM-dd')\r",
				"    ), \r",
				"    toDate('1900-01-01', 'yyyy-MM-dd')\r",
				"),",
				"          VigenciaHasta = coalesce(\r",
				"    iif(\r",
				"        instr(VigenciaHasta, '/') > 0, \r",
				"        toDate(VigenciaHasta, 'dd/MM/yyyy'), \r",
				"        toDate(VigenciaHasta, 'yyyy-MM-dd')\r",
				"    ), \r",
				"    toDate('1900-01-01', 'yyyy-MM-dd')\r",
				")) ~> derivedColumn3",
				"derivedColumn1 aggregate(groupBy(ParadaHistoricaId),",
				"     CodigoPublicado = first(CodigoPublicado),",
				"          NombreParada = first(NombreParada),",
				"          Zona = first(Zona),",
				"          Latitud = first(Latitud),",
				"          Longitud = first(Longitud),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}