{
	"name": "df_silver_vehiculos",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "Vehiculos"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Vehiculos",
				"Vehiculos derive(VehiculoId = iif(startsWith(trim(VehiculoId), 'V-'), upper(trim(VehiculoId)), concat('V-', trim(VehiculoId))),",
				"          Placa = upper(trim(Placa)),",
				"          TipoVehiculo = upper(trim(TipoVehiculo)),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"aggregate1 derive(CapacidadEfectiva = toInteger(coalesce(trim(CapacidadEfectiva), '0')),",
				"          VigenciaDesde = coalesce(\r",
				"    iif(\r",
				"        instr(VigenciaDesde, '/') > 0, \r",
				"        toDate(VigenciaDesde, 'dd/MM/yyyy'), \r",
				"        toDate(VigenciaDesde, 'yyyy-MM-dd')\r",
				"    ), \r",
				"    toDate('1900-01-01', 'yyyy-MM-dd')\r",
				"),",
				"          VigenciaHasta = coalesce(\r",
				"    iif(\r",
				"        instr(VigenciaHasta, '/') > 0, \r",
				"        toDate(VigenciaHasta, 'dd/MM/yyyy'), \r",
				"        toDate(VigenciaHasta, 'yyyy-MM-dd')\r",
				"    ), \r",
				"    toDate('1900-01-01', 'yyyy-MM-dd')\r",
				")) ~> derivedColumn2",
				"derivedColumn1 aggregate(groupBy(VehiculoId),",
				"     Placa = first(Placa),",
				"          TipoVehiculo = first(TipoVehiculo),",
				"          CapacidadEfectiva = first(CapacidadEfectiva),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}