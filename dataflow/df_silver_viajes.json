{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "viajes"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> viajes",
				"viajes filter(regexMatch(trim(ViajeId), '^(VJ-\\\\d{4}-\\\\d{5}|\\\\d{5})$')) ~> filter1",
				"filter1 derive(FechaServicio = case(\r",
				"  regexMatch(toString(FechaServicio), '^\\\\d{4}-\\\\d{2}-\\\\d{2}$'), toDate(toString(FechaServicio), 'yyyy-MM-dd'),\r",
				"  regexMatch(toString(FechaServicio), '^\\\\d{2}/\\\\d{2}/\\\\d{4}$'), toDate(toString(FechaServicio), 'dd/MM/yyyy'),\r",
				"  regexMatch(toString(FechaServicio), '^\\\\d{5}$'), addDays(toDate('1899-12-30'), toInteger(toString(FechaServicio))),\r",
				"  toDate(null())),",
				"          HoraProgramada = toTimestamp(\r",
				"  concat('1900-01-01 ',\r",
				"         lpad(regexExtract(toString(HoraProgramada), '(\\\\d{1,2}):\\\\d{2}', 1), 2, '0'), ':',\r",
				"         regexExtract(toString(HoraProgramada), '\\\\d{1,2}:(\\\\d{2})', 1), ':00'),\r",
				"  'yyyy-MM-dd HH:mm:ss'),",
				"          HoraSalida = toTimestamp(\r",
				"  concat('1900-01-01 ',\r",
				"         lpad(regexExtract(toString(HoraSalida), '(\\\\d{1,2}):\\\\d{2}', 1), 2, '0'), ':',\r",
				"         regexExtract(toString(HoraSalida), '\\\\d{1,2}:(\\\\d{2})', 1), ':00'),\r",
				"  'yyyy-MM-dd HH:mm:ss'),",
				"          HoraLlegada = toTimestamp(\r",
				"  concat('1900-01-01 ',\r",
				"         lpad(regexExtract(toString(HoraLlegada), '(\\\\d{1,2}):\\\\d{2}', 1), 2, '0'), ':',\r",
				"         regexExtract(toString(HoraLlegada), '\\\\d{1,2}:(\\\\d{2})', 1), ':00'),\r",
				"  'yyyy-MM-dd HH:mm:ss'),",
				"          KmRecorridos = toDecimal(replace(toString(KmRecorridos), ',', '.'), 10, 2),",
				"          ValidacionesTarjeta = iif(isNull(ValidacionesTarjeta), toInteger(null()),\r",
				"    iif(trim(toString(ValidacionesTarjeta)) == '', toInteger(null()),\r",
				"        toInteger(toString(ValidacionesTarjeta)))),",
				"          RutaHistoricaId = concat('RH-', lpad(regexExtract(trim(RutaHistoricaId), '(\\\\d+)', 1), 2, '0'),\r",
				"  iif(regexMatch(upper(trim(RutaHistoricaId)), '.*-(N|S|NEW)$'),\r",
				"      concat('-', regexExtract(upper(trim(RutaHistoricaId)), '-(N|S|NEW)$', 1)),\r",
				"      '')),",
				"          VehiculoId = concat('V-', lpad(regexExtract(trim(VehiculoId), '(\\\\d+)', 1), 3, '0')),",
				"          EstadoViaje = upper(trim(EstadoViaje))) ~> derivedColumn1",
				"derivedColumn1 derive(ViajeId = iif(regexMatch(trim(ViajeId), '^VJ-\\\\d{4}-\\\\d{5}$'),\r",
				"    trim(ViajeId),\r",
				"    concat('VJ-', toString(year(FechaServicio)), '-', trim(ViajeId)))) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(ViajeId),",
				"     RutaHistoricaId = first(RutaHistoricaId),",
				"          VehiculoId = first(VehiculoId),",
				"          FechaServicio = first(FechaServicio),",
				"          HoraProgramada = first(HoraProgramada),",
				"          HoraSalida = first(HoraSalida),",
				"          HoraLlegada = first(HoraLlegada),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta, true()),",
				"          KmRecorridos = first(KmRecorridos),",
				"          EstadoViaje = first(EstadoViaje)) ~> aggregate1",
				"aggregate1 derive(EstadoViaje = iifNull(EstadoViaje, ''),",
				"          ValidacionesTarjeta = iifNull(ValidacionesTarjeta, 0)) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}