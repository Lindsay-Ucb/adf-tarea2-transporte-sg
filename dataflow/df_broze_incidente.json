{
	"name": "df_broze_incidente",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_incidentes_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidente_ruta_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidentes_2022_xls",
						"type": "DatasetReference"
					},
					"name": "xls2022"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidentes_2023_xls",
						"type": "DatasetReference"
					},
					"name": "xls2023"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "select4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          AnioFuente as integer,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls2022",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls2023",
				"xls2022 select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          fecha_inicio,",
				"          hora_inicio,",
				"          fecha_fin,",
				"          hora_fin,",
				"          fecha_registro,",
				"          rutas_afectadas,",
				"          vehiculo_afectado,",
				"          descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"xls2023 select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          fecha_inicio,",
				"          hora_inicio,",
				"          fecha_fin,",
				"          hora_fin,",
				"          fecha_registro,",
				"          rutas_afectadas,",
				"          vehiculo_afectado,",
				"          descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"csv select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          fecha_inicio,",
				"          hora_inicio,",
				"          fecha_fin,",
				"          hora_fin,",
				"          FechaHoraRegistro = fecha_registro,",
				"          rutas_afectadas,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4"
			]
		}
	}
}